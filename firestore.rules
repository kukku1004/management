rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email() { return request.auth.token.email.lower(); }
    function profile() { return get(/databases/$(database)/documents/users/$(email())).data; }
    function isAdmin() { return signedIn() && profile().role == 'admin'; }
    function isTeamLeader(teamId) { return signedIn() && profile().role == 'leader' && teamId in profile().teamIds; }
    function canSeeTeam(teamId) { return isAdmin() || isTeamLeader(teamId) || (signedIn() && profile().role == 'leader' && profile().canViewOtherTeams == true); }
    function isSelf(memberEmail) { return signedIn() && memberEmail == email(); }
    match /invites/{invitedEmail} {
      allow read: if signedIn() && (isAdmin() || invitedEmail == email());
      allow write: if isAdmin();
    }
    match /users/{userEmail} {
      allow read: if signedIn() && (isAdmin() || userEmail == email());
      allow create: if signedIn() && userEmail == email() && (
        (email() == 'jjy.osstem@gmail.com' && request.resource.data.role == 'admin') ||
        (exists(/databases/$(database)/documents/invites/$(email())) && request.resource.data.role == get(/databases/$(database)/documents/invites/$(email())).data.role)
      );
      allow update: if isAdmin() || (signedIn() && userEmail == email() && request.resource.data.role == resource.data.role && request.resource.data.teamIds == resource.data.teamIds && request.resource.data.canViewOtherTeams == resource.data.canViewOtherTeams);
      allow delete: if isAdmin();
    }
    match /teams/{teamId} {
      allow read, write: if canSeeTeam(teamId);

      match /members/{memberEmail} {
        allow read: if canSeeTeam(teamId) || isSelf(memberEmail);
        allow write: if canSeeTeam(teamId);
      }
      match /tasks/{taskId} {
        allow read: if canSeeTeam(teamId) || (signedIn() && (resource.data.ownerEmail == email() || email() in resource.data.assigneeEmails));
        allow create: if canSeeTeam(teamId) || (signedIn() && request.resource.data.ownerEmail == email());
        allow update, delete: if canSeeTeam(teamId) || (signedIn() && resource.data.ownerEmail == email() && request.resource.data.ownerEmail == email());
      }
      match /peerReviews/{reviewId} {
        allow read: if canSeeTeam(teamId) || (signedIn() && resource.data.reviewerEmail == email());
        allow create: if signedIn() && request.resource.data.reviewerEmail == email();
        allow update, delete: if canSeeTeam(teamId) || (signedIn() && resource.data.reviewerEmail == email() && request.resource.data.reviewerEmail == email());
      }
      match /results/{memberEmail} {
        allow read: if canSeeTeam(teamId) || isSelf(memberEmail);
        allow write: if canSeeTeam(teamId);
      }
      match /growth/{memberEmail} {
        allow read: if canSeeTeam(teamId) || isSelf(memberEmail);
        allow write: if canSeeTeam(teamId);
      }
      match /meetingNotes/{memberEmail} {
        allow read: if canSeeTeam(teamId) || isSelf(memberEmail);
        allow write: if canSeeTeam(teamId);
      }
      match /{document=**} {
        allow read, write: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
